# Copy to backend/.env and fill in your Supabase project values.
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ML models (defaults shown; override to swap models)
HF_NLP_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
